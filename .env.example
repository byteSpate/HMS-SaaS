# Copy to .env for local development. Never commit .env.
# Local values match docker/compose.dev.yaml and docker/postgres/initdb/10-roles.sql (dev only).
# Staging is configured separately by the server owner (docs/DEPLOYMENT.md). When code starts
# reading a new variable, list it under "Deploy impact" in the PR so the server can get it first.

# Migrations: direct connection as hms_migrator. On Supabase use the direct/session connection (port 5432).
DATABASE_MIGRATOR_URL=postgresql://hms_migrator:dev_migrator@localhost:5432/hms?schema=hms

# Application: hms_app (RLS enforced). On Supabase use the transaction pooler (port 6543).
DATABASE_URL=postgresql://hms_app:dev_app@localhost:5432/hms?schema=hms

VALKEY_URL=redis://localhost:6379/0

# Supabase (fill in locally; never commit). See docker/postgres/supabase/10-roles.sql and ADR-019.
# SUPABASE_ADMIN_URL=      postgres user, setup only (bypasses RLS: never used by the app)
# SUPABASE_MIGRATOR_URL=   hms_migrator via session pooler :5432, ?schema=hms
# SUPABASE_APP_URL=        hms_app via transaction pooler :6543, ?schema=hms

API_PORT=4100
# Production API origin for Swagger's "Servers" dropdown (ADR-021). Override for staging.
# API_PUBLIC_URL=https://healthcareapi.bytespate.com
TZ=UTC

# Login (C-032 defaults; per-hospital overrides come with policy versions)
SESSION_IDLE_TIMEOUT_MIN=60
SESSION_ABSOLUTE_TIMEOUT_H=12
# Lock after this many wrong passwords, for this many minutes (C-032; optional, T-ACC-03)
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# DEV ONLY value; generate a real one with: openssl rand -base64 48
CSRF_SECRET=dev-only-csrf-secret-change-me-0123456789
# Encrypts TOTP secrets at rest (T-ACC-04). DEV ONLY value; generate a real one with:
# openssl rand -base64 32
MFA_ENCRYPTION_KEY=ZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGQ=
# Name shown in authenticator apps (optional, default HMS)
# MFA_ISSUER=HMS
# Web origins allowed to call the API (ADR-021): the staff app, and the dev proxy that joins it
# with the site on one origin (apps/dev-proxy)
CORS_ORIGINS=http://localhost:3100,http://localhost:3000
