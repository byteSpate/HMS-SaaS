// Authoritative data design: docs/planning/docs/E-database-design.md.
// All tables live in the `hms` schema (never `public`, which Supabase exposes through its Data API).
// IDs are UUIDv7 generated by Prisma: Supabase runs PostgreSQL 17, which lacks built-in uuidv7() (ADR-019).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["hms"]
}

enum TenantStatus {
  PROVISIONING
  PROVISIONED
  ACTIVE
  SUSPENDED
  TERMINATED

  @@schema("hms")
}

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique
  nameEn    String?      @map("name_en")
  nameBn    String?      @map("name_bn")
  status    TenantStatus @default(PROVISIONED)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  version   Int          @default(1)

  facilities   Facility[]
  memberships  Membership[]
  auditEvents  AuditEvent[]
  roles        Role[]
  entitlements TenantEntitlement[]

  @@map("tenant")
  @@schema("hms")
}

// Tenant-owned tables carry tenant_id, UNIQUE (tenant_id, id), and composite foreign keys to
// their parents, so a child can never point at another tenant's row (ADR-003, E §6).
// Row-level security for every tenant-owned table is added in SQL in the same migration.

model Facility {
  tenantId String  @map("tenant_id") @db.Uuid
  id       String  @id @default(uuid(7)) @db.Uuid
  code     String
  nameEn   String? @map("name_en")
  nameBn   String? @map("name_bn")
  timezone String  @default("Asia/Dhaka")
  version  Int     @default(1)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  departments Department[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("facility")
  @@schema("hms")
}

model Department {
  tenantId   String  @map("tenant_id") @db.Uuid
  id         String  @id @default(uuid(7)) @db.Uuid
  facilityId String  @map("facility_id") @db.Uuid
  code       String
  nameEn     String? @map("name_en")
  nameBn     String? @map("name_bn")

  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, code])
  @@map("department")
  @@schema("hms")
}

enum UserStatus {
  ACTIVE
  LOCKED_TEMPORARY
  LOCKED_ADMIN
  DISABLED

  @@schema("hms")
}

enum PreferredLang {
  bn_BD @map("bn-BD")
  en

  @@schema("hms")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("hms")
}

enum EventOutcome {
  SUCCEEDED
  DENIED
  FAILED

  @@schema("hms")
}

// Global login identity: one person may belong to several hospitals (E section 6, ADR-004).
// Not tenant-scoped, so no RLS. Usernames are stored lower-case (CHECK in the migration).
model UserAccount {
  id             String        @id @default(uuid(7)) @db.Uuid
  username       String        @unique
  displayName    String        @map("display_name")
  passwordHash   String        @map("password_hash")
  status         UserStatus    @default(ACTIVE)
  failedAttempts Int           @default(0) @map("failed_attempts")
  lockedUntil    DateTime?     @map("locked_until") @db.Timestamptz
  // T-ACC-03 (FR-ACC-004): why, when and by whom the account was locked. lockReason is a code
  // (FAILED_LOGINS, ADMIN_ACTION); lockNote is the administrator's reason; lockedByUserId is
  // null when the system locked it after failed logins.
  lockReason     String?       @map("lock_reason")
  lockedAt       DateTime?     @map("locked_at") @db.Timestamptz
  lockNote       String?       @map("lock_note")
  lockedByUserId String?       @map("locked_by_user_id") @db.Uuid
  preferredLang  PreferredLang @default(bn_BD) @map("preferred_lang")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  version        Int           @default(1)

  memberships   Membership[]
  sessions      UserSession[]
  mfa           UserMfa?
  recoveryCodes UserMfaRecoveryCode[]

  @@map("user_account")
  @@schema("hms")
}

// A user's access to one hospital, with its roles (T-ACC-02). Facility and department scope
// (FR-ACC-008) arrive with the first command that checks it.
model Membership {
  tenantId  String           @map("tenant_id") @db.Uuid
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  version   Int              @default(1)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  user     UserAccount      @relation(fields: [userId], references: [id])
  sessions UserSession[]
  roles    MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("membership")
  @@schema("hms")
}

// A hospital's own role. It starts as a copy of a product template (template_code) and the
// hospital may add or remove permissions (FR-ACC-008, C-045).
model Role {
  tenantId     String   @map("tenant_id") @db.Uuid
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String
  nameEn       String   @map("name_en")
  nameBn       String?  @map("name_bn")
  templateCode String?  @map("template_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  version      Int      @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("role")
  @@schema("hms")
}

// Permission codes come from the catalogue in @hms/contracts; the database checks only the format.
model RolePermission {
  tenantId       String @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, roleId, permissionCode])
  @@map("role_permission")
  @@schema("hms")
}

model MembershipRole {
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_role")
  @@schema("hms")
}

// Modules the hospital has bought (FR-SAA-004). An entitlement never grants a permission.
// The core module needs no row (coreModules in @hms/contracts).
model TenantEntitlement {
  tenantId   String   @map("tenant_id") @db.Uuid
  moduleCode String   @map("module_code")
  enabledAt  DateTime @default(now()) @map("enabled_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, moduleCode])
  @@map("tenant_entitlement")
  @@schema("hms")
}

// Server-side session, found by SHA-256 of the cookie token (the raw token is never stored).
// tenant_id/membership_id are null until the user chooses a hospital.
model UserSession {
  tokenHash         Bytes     @id @map("token_hash")
  userId            String    @map("user_id") @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  membershipId      String?   @map("membership_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  // T-ACC-04 (FR-ACC-006): when this session passed the second factor; null until then.
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz

  user       UserAccount @relation(fields: [userId], references: [id])
  membership Membership? @relation(fields: [tenantId, membershipId], references: [tenantId, id])

  @@index([userId])
  @@map("user_session")
  @@schema("hms")
}

// A user's TOTP second factor (T-ACC-04, FR-ACC-006, ADR-004). The secret is encrypted with
// MFA_ENCRYPTION_KEY (AES-256-GCM). enabledAt stays null until the first code confirms the
// enrolment. lastUsedStep refuses a code whose time step was already used (replay, AT-ACC-010).
model UserMfa {
  userId           String    @id @map("user_id") @db.Uuid
  secretCiphertext Bytes     @map("secret_ciphertext")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz
  lastUsedStep     BigInt?   @map("last_used_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
  @@schema("hms")
}

// Single-use recovery codes, stored as SHA-256 hashes (T-ACC-04, D section 7.1).
model UserMfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  Bytes     @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("user_mfa_recovery_code")
  @@schema("hms")
}

// Authentication events that happen before a hospital is known (decision 1 of the T-ACC-01 plan).
// Append-only: the app may insert and read, never update or delete.
model AuthEvent {
  id                String       @id @default(uuid(7)) @db.Uuid
  occurredAt        DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  action            String
  outcome           EventOutcome
  userId            String?      @map("user_id") @db.Uuid
  usernameAttempted String?      @map("username_attempted")
  reason            String?
  ipAddress         String?      @map("ip_address")
  correlationId     String?      @map("correlation_id")

  @@index([userId, occurredAt])
  @@map("auth_event")
  @@schema("hms")
}

// Tenant audit trail (FR-AUD-001). Append-only; details hold IDs and codes, never clinical text.
model AuditEvent {
  tenantId      String       @map("tenant_id") @db.Uuid
  id            String       @id @default(uuid(7)) @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  membershipId  String?      @map("membership_id") @db.Uuid
  action        String
  targetType    String?      @map("target_type")
  targetId      String?      @map("target_id") @db.Uuid
  outcome       EventOutcome
  reason        String?
  correlationId String?      @map("correlation_id")
  details       Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, actorUserId, occurredAt])
  @@index([tenantId, targetType, targetId, occurredAt])
  @@map("audit_event")
  @@schema("hms")
}
