// Authoritative data design: docs/planning/docs/E-database-design.md.
// All tables live in the `hms` schema (never `public`, which Supabase exposes through its Data API).
// IDs are UUIDv7 generated by Prisma: Supabase runs PostgreSQL 17, which lacks built-in uuidv7() (ADR-019).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["hms"]
}

enum TenantStatus {
  PROVISIONING
  PROVISIONED
  ACTIVE
  SUSPENDED
  TERMINATED

  @@schema("hms")
}

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique
  nameEn    String?      @map("name_en")
  nameBn    String?      @map("name_bn")
  status    TenantStatus @default(PROVISIONED)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  version   Int          @default(1)

  facilities       Facility[]
  memberships      Membership[]
  auditEvents      AuditEvent[]
  roles            Role[]
  entitlements     TenantEntitlement[]
  numberSequences  NumberSequence[]
  policyVersions   PolicyVersion[]
  userAccounts     UserAccount[]
  patients         Patient[]
  practitioners    Practitioner[]
  scheduleSessions ScheduleSession[]
  appointments     Appointment[]
  serviceItems     ServiceItem[]
  priceLists       PriceListVersion[]
  priceListItems   PriceListItem[]

  invoices     Invoice[]
  charges      Charge[]
  invoiceLines InvoiceLine[]

  visits Visit[]

  cashierSessions      CashierSession[]
  cashierSessionCounts CashierSessionCount[]
  payments             Payment[]
  paymentAllocations   PaymentAllocation[]
  receiptPrints        ReceiptPrint[]

  @@map("tenant")
  @@schema("hms")
}

// Tenant-owned tables carry tenant_id, UNIQUE (tenant_id, id), and composite foreign keys to
// their parents, so a child can never point at another tenant's row (ADR-003, E §6).
// Row-level security for every tenant-owned table is added in SQL in the same migration.

model Facility {
  tenantId String  @map("tenant_id") @db.Uuid
  id       String  @id @default(uuid(7)) @db.Uuid
  code     String
  nameEn   String? @map("name_en")
  nameBn   String? @map("name_bn")
  timezone String  @default("Asia/Dhaka")
  version  Int     @default(1)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  departments      Department[]
  scheduleSessions ScheduleSession[]

  visits Visit[]

  cashierSessions CashierSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("facility")
  @@schema("hms")
}

// A department of a facility (T-PRA-02; FR-CFG-001). Code format, a name in one script at least,
// and the column UPDATE grant are in the migration SQL.
model Department {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @id @default(uuid(7)) @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  code       String
  nameEn     String?  @map("name_en")
  nameBn     String?  @map("name_bn")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String   @map("created_by") @db.Uuid
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy  String   @map("updated_by") @db.Uuid
  version    Int      @default(1)

  facility      Facility       @relation(fields: [tenantId, facilityId], references: [tenantId, id])
  practitioners Practitioner[]

  visits Visit[]

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, code])
  @@map("department")
  @@schema("hms")
}

enum UserStatus {
  ACTIVE
  LOCKED_TEMPORARY
  LOCKED_ADMIN
  DISABLED

  @@schema("hms")
}

enum PreferredLang {
  bn_BD @map("bn-BD")
  en

  @@schema("hms")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("hms")
}

enum EventOutcome {
  SUCCEEDED
  DENIED
  FAILED

  @@schema("hms")
}

// Global login identity: one person may belong to several hospitals (E section 6, ADR-004).
// Not tenant-scoped, so no RLS. Usernames are stored lower-case (CHECK in the migration).
model UserAccount {
  id                       String        @id @default(uuid(7)) @db.Uuid
  // T-ACC-06 (C-099): an account belongs to one hospital. Nullable until a later release.
  tenantId                 String?       @map("tenant_id") @db.Uuid
  username                 String
  displayName              String        @map("display_name")
  passwordHash             String        @map("password_hash")
  status                   UserStatus    @default(ACTIVE)
  failedAttempts           Int           @default(0) @map("failed_attempts")
  lockedUntil              DateTime?     @map("locked_until") @db.Timestamptz
  // T-ACC-03 (FR-ACC-004): why, when and by whom the account was locked. lockReason is a code
  // (FAILED_LOGINS, ADMIN_ACTION); lockNote is the administrator's reason; lockedByUserId is
  // null when the system locked it after failed logins.
  lockReason               String?       @map("lock_reason")
  lockedAt                 DateTime?     @map("locked_at") @db.Timestamptz
  lockNote                 String?       @map("lock_note")
  lockedByUserId           String?       @map("locked_by_user_id") @db.Uuid
  // T-ACC-05 (FR-ACC-007): a password set by an administrator must be changed at next login.
  mustChangePassword       Boolean       @default(false) @map("must_change_password")
  passwordChangedAt        DateTime?     @map("password_changed_at") @db.Timestamptz
  // C-093: when the person asked for a new password; cleared when one is set.
  passwordResetRequestedAt DateTime?     @map("password_reset_requested_at") @db.Timestamptz
  preferredLang            PreferredLang @default(bn_BD) @map("preferred_lang")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  version                  Int           @default(1)

  memberships   Membership[]
  sessions      UserSession[]
  mfa           UserMfa?
  recoveryCodes UserMfaRecoveryCode[]

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, username])
  @@map("user_account")
  @@schema("hms")
}

// A user's access to one hospital, with its roles (T-ACC-02). Facility and department scope
// (FR-ACC-008) arrive with the first command that checks it.
model Membership {
  tenantId  String           @map("tenant_id") @db.Uuid
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  version   Int              @default(1)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  user     UserAccount      @relation(fields: [userId], references: [id])
  sessions UserSession[]
  roles    MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("membership")
  @@schema("hms")
}

// A hospital's own role. It starts as a copy of a product template (template_code) and the
// hospital may add or remove permissions (FR-ACC-008, C-045).
model Role {
  tenantId     String   @map("tenant_id") @db.Uuid
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String
  nameEn       String   @map("name_en")
  nameBn       String?  @map("name_bn")
  templateCode String?  @map("template_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  version      Int      @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("role")
  @@schema("hms")
}

// Permission codes come from the catalogue in @hms/contracts; the database checks only the format.
model RolePermission {
  tenantId       String @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, roleId, permissionCode])
  @@map("role_permission")
  @@schema("hms")
}

model MembershipRole {
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_role")
  @@schema("hms")
}

// Modules the hospital has bought (FR-SAA-004). An entitlement never grants a permission.
// The core module needs no row (coreModules in @hms/contracts).
model TenantEntitlement {
  tenantId   String   @map("tenant_id") @db.Uuid
  moduleCode String   @map("module_code")
  enabledAt  DateTime @default(now()) @map("enabled_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, moduleCode])
  @@map("tenant_entitlement")
  @@schema("hms")
}

// Server-side session, found by SHA-256 of the cookie token (the raw token is never stored).
// tenant_id/membership_id are null until the user chooses a hospital.
model UserSession {
  tokenHash         Bytes     @id @map("token_hash")
  userId            String    @map("user_id") @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  membershipId      String?   @map("membership_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  // T-ACC-04 (FR-ACC-006): when this session passed the second factor; null until then.
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz

  user       UserAccount @relation(fields: [userId], references: [id])
  membership Membership? @relation(fields: [tenantId, membershipId], references: [tenantId, id])

  @@index([userId])
  @@map("user_session")
  @@schema("hms")
}

// A user's TOTP second factor (T-ACC-04, FR-ACC-006, ADR-004). The secret is encrypted with
// MFA_ENCRYPTION_KEY (AES-256-GCM). enabledAt stays null until the first code confirms the
// enrolment. lastUsedStep refuses a code whose time step was already used (replay, AT-ACC-010).
model UserMfa {
  userId           String    @id @map("user_id") @db.Uuid
  secretCiphertext Bytes     @map("secret_ciphertext")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz
  lastUsedStep     BigInt?   @map("last_used_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
  @@schema("hms")
}

// Single-use recovery codes, stored as SHA-256 hashes (T-ACC-04, D section 7.1).
model UserMfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  Bytes     @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("user_mfa_recovery_code")
  @@schema("hms")
}

// Authentication events that happen before a hospital is known (decision 1 of the T-ACC-01 plan).
// Append-only: the app may insert and read, never update or delete.
model AuthEvent {
  id                String       @id @default(uuid(7)) @db.Uuid
  occurredAt        DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  action            String
  outcome           EventOutcome
  userId            String?      @map("user_id") @db.Uuid
  usernameAttempted String?      @map("username_attempted")
  reason            String?
  ipAddress         String?      @map("ip_address")
  correlationId     String?      @map("correlation_id")

  @@index([userId, occurredAt])
  @@map("auth_event")
  @@schema("hms")
}

// Tenant audit trail (FR-AUD-001). Append-only; details hold IDs and codes, never clinical text.
model AuditEvent {
  tenantId      String       @map("tenant_id") @db.Uuid
  id            String       @id @default(uuid(7)) @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  membershipId  String?      @map("membership_id") @db.Uuid
  action        String
  targetType    String?      @map("target_type")
  targetId      String?      @map("target_id") @db.Uuid
  outcome       EventOutcome
  reason        String?
  correlationId String?      @map("correlation_id")
  details       Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, actorUserId, occurredAt])
  @@index([tenantId, targetType, targetId, occurredAt])
  @@index([tenantId, action, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("audit_event")
  @@schema("hms")
}

// Idempotency record of one command (T-PLT-01, D section 9.3). Written in the command's transaction.
model IdempotencyRecord {
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  idemKey     String   @map("idem_key")
  operation   String
  requestHash Bytes    @map("request_hash")
  // IN_PROGRESS or COMPLETED (CHECK idempotency_record_status_check).
  status      String
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)")) @map("expires_at") @db.Timestamptz

  @@id([tenantId, actorUserId, idemKey])
  @@index([expiresAt])
  @@map("idempotency_record")
  @@schema("hms")
}

// Business number sequence of one hospital (T-PLT-04, FR-CFG-003).
model NumberSequence {
  tenantId    String @map("tenant_id") @db.Uuid
  sequenceKey String @map("sequence_key")
  nextValue   BigInt @default(1) @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, sequenceKey])
  @@map("number_sequence")
  @@schema("hms")
}

// Events written in the business transaction, sent by the relay (T-PLT-03, ADR-006).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  schemaVersion Int       @default(1) @map("schema_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  correlationId String?   @map("correlation_id")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  attempts      Int       @default(0)

  @@map("outbox_event")
  @@schema("hms")
}

// One row per consumer and event, so a repeated delivery does nothing (T-PLT-03).
model InboxEvent {
  tenantId    String   @map("tenant_id") @db.Uuid
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("inbox_event")
  @@schema("hms")
}

// Effective-dated hospital settings, append-only (T-PLT-05, FR-CFG-002, FR-SAA-005).
model PolicyVersion {
  tenantId      String   @map("tenant_id") @db.Uuid
  id            String   @id @default(uuid(7)) @db.Uuid
  policyKey     String   @map("policy_key")
  versionNo     Int      @map("version_no")
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz
  body          Json
  publishedBy   String?  @map("published_by") @db.Uuid
  publishedAt   DateTime @map("published_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, policyKey, versionNo])
  @@index([tenantId, policyKey, effectiveFrom])
  @@map("policy_version")
  @@schema("hms")
}

// A patient of one hospital (T-PAT-01, E section 5.1). id and mrn never change. Codes and the
// birth rules (EXACT date, or YEAR_ESTIMATED from a reported age) are CHECKs in the migration.
// The trigram name indexes are SQL only, because Prisma cannot express them.
model Patient {
  tenantId           String    @map("tenant_id") @db.Uuid
  id                 String    @id @default(uuid(7)) @db.Uuid
  mrn                String
  identityStatus     String    @default("CONFIRMED") @map("identity_status")
  nameBn             String?   @map("name_bn")
  nameEn             String?   @map("name_en")
  sex                String
  birthDate          DateTime? @map("birth_date") @db.Date
  birthDatePrecision String    @map("birth_date_precision")
  birthYear          Int?      @map("birth_year") @db.SmallInt
  reportedAgeYears   Int?      @map("reported_age_years") @db.SmallInt
  reportedAgeOn      DateTime? @map("reported_age_on") @db.Date
  phoneRaw           String?   @map("phone_raw")
  phoneNormalized    String?   @map("phone_normalized")
  addressText        String?   @map("address_text")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy          String    @map("created_by") @db.Uuid
  version            Int       @default(1)

  tenant                   Tenant                   @relation(fields: [tenantId], references: [id])
  patientIdentifiers       PatientIdentifier[]
  patientIdentityHistories PatientIdentityHistory[]
  appointments             Appointment[]

  invoices Invoice[]
  charges  Charge[]
  payments Payment[]

  visits Visit[]

  @@unique([tenantId, id])
  @@unique([tenantId, mrn])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, birthYear])
  @@map("patient")
  @@schema("hms")
}

// A practitioner: a professional identity, not an employee record (T-PRA-01; FR-PRA-001..003;
// E section 5.1). Names may repeat across practitioners. Name and blank-text CHECKs and the
// column-level UPDATE grant are in the migration. No delete: `active` is turned off instead.
model Practitioner {
  tenantId       String   @map("tenant_id") @db.Uuid
  id             String   @id @default(uuid(7)) @db.Uuid
  nameBn         String?  @map("name_bn")
  nameEn         String?  @map("name_en")
  degrees        String?
  specialty      String?
  phone          String?
  registrationNo String?  @map("registration_no")
  departmentId   String?  @map("department_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String   @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String   @map("updated_by") @db.Uuid
  version        Int      @default(1)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  department       Department?       @relation(fields: [tenantId, departmentId], references: [tenantId, id])
  scheduleSessions ScheduleSession[]
  priceListItems   PriceListItem[]

  charges Charge[]

  visits Visit[]

  @@unique([tenantId, id])
  @@index([tenantId, departmentId])
  @@map("practitioner")
  @@schema("hms")
}

// One sitting of a practitioner on one hospital date (T-SCH-01; FR-SCH-002; C-035; E section 5.3).
// Fixed capacity, no overbooking: the booked_count CHECK, the status CHECK and the column UPDATE
// grant are in the migration. No delete: a session is cancelled.
model ScheduleSession {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @id @default(uuid(7)) @db.Uuid
  practitionerId  String   @map("practitioner_id") @db.Uuid
  facilityId      String   @map("facility_id") @db.Uuid
  sessionDate     DateTime @map("session_date") @db.Date
  startsAt        DateTime @map("starts_at") @db.Timestamptz
  endsAt          DateTime @map("ends_at") @db.Timestamptz
  capacity        Int
  bookedCount     Int      @default(0) @map("booked_count")
  lastQueueNumber Int      @default(0) @map("last_queue_number")
  /// DRAFT, PUBLISHED or CANCELLED (CHECK in the migration).
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String   @map("created_by") @db.Uuid
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String   @map("updated_by") @db.Uuid
  version         Int      @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  practitioner Practitioner  @relation(fields: [tenantId, practitionerId], references: [tenantId, id])
  facility     Facility      @relation(fields: [tenantId, facilityId], references: [tenantId, id])
  appointments Appointment[]

  visits Visit[]

  @@unique([tenantId, id])
  @@index([tenantId, sessionDate])
  @@index([tenantId, practitionerId, sessionDate])
  @@map("schedule_session")
  @@schema("hms")
}

// A booking of a patient into a schedule session (T-SCH-02; FR-SCH-001..005; UC-SCH-01/02). Status,
// cancel-reason and one-live-booking-per-patient rules and the column UPDATE grant are in the
// migration. No delete: an appointment is cancelled.
model Appointment {
  tenantId          String   @map("tenant_id") @db.Uuid
  id                String   @id @default(uuid(7)) @db.Uuid
  patientId         String   @map("patient_id") @db.Uuid
  scheduleSessionId String   @map("schedule_session_id") @db.Uuid
  /// BOOKED, CHECKED_IN, RESCHEDULED, CANCELLED or NO_SHOW (CHECK in the migration).
  status            String   @default("BOOKED")
  rescheduledFromId String?  @map("rescheduled_from_id") @db.Uuid
  cancelReason      String?  @map("cancel_reason")
  bookedAt          DateTime @default(now()) @map("booked_at") @db.Timestamptz
  bookedBy          String   @map("booked_by") @db.Uuid
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy         String   @map("updated_by") @db.Uuid
  version           Int      @default(1)

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  patient         Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id])
  scheduleSession ScheduleSession @relation(fields: [tenantId, scheduleSessionId], references: [tenantId, id])
  rescheduledFrom Appointment?    @relation("Rescheduled", fields: [tenantId, rescheduledFromId], references: [tenantId, id])
  rescheduledTo   Appointment?    @relation("Rescheduled")

  visit Visit?

  @@unique([tenantId, id])
  @@unique([tenantId, rescheduledFromId])
  @@index([tenantId, scheduleSessionId, status])
  @@index([tenantId, patientId])
  @@map("appointment")
  @@schema("hms")
}

// An identity document of a patient (T-PAT-03, E section 5.2). The value is sealed by the API
// (AES-256-GCM, NID_ENCRYPTION_KEY) and found by its keyed hash; only the last four characters
// are stored readable, for masked display (FR-PAT-007). Kinds are a CHECK in the migration.
model PatientIdentifier {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @id @default(uuid(7)) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  kind            String
  valueCiphertext Bytes    @map("value_ciphertext")
  valueHash       Bytes    @map("value_hash")
  valueLast4      String   @map("value_last4")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String   @map("created_by") @db.Uuid

  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@unique([tenantId, patientId, kind])
  @@index([tenantId, kind, valueHash])
  @@map("patient_identifier")
  @@schema("hms")
}

// Previous identity values of a patient, one row per correction (T-PAT-04, FR-PAT-008).
// Append-only; a previous NID is kept sealed (previousNidCiphertext) and by its last four digits.
model PatientIdentityHistory {
  tenantId              String   @map("tenant_id") @db.Uuid
  id                    String   @id @default(uuid(7)) @db.Uuid
  patientId             String   @map("patient_id") @db.Uuid
  version               Int
  changedFields         String[] @map("changed_fields")
  previousValues        Json     @map("previous_values")
  previousNidCiphertext Bytes?   @map("previous_nid_ciphertext")
  reason                String
  changedAt             DateTime @default(now()) @map("changed_at") @db.Timestamptz
  changedBy             String   @map("changed_by") @db.Uuid

  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@unique([tenantId, patientId, version])
  @@map("patient_identity_history")
  @@schema("hms")
}

// A billable thing of the hospital's catalogue (T-BIL-01; E section 4, mod-billing). For now only
// the two system items of doctor fees exist (DOCTOR_FEE_NEW, DOCTOR_FEE_FOLLOW_UP; C-041); the
// rest of the catalogue comes with orders (T-ORD-01). Their names are in the i18n catalogs by
// code. Category values are a CHECK in the migration.
model ServiceItem {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String
  nameEn    String?  @map("name_en")
  nameBn    String?  @map("name_bn")
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  priceListItems PriceListItem[]

  charges Charge[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("service_item")
  @@schema("hms")
}

// A version of the hospital's price list (T-BIL-01; FR-CFG-002; FR-BIL-007). Edited as a DRAFT,
// then PUBLISHED with an effective time; the version in force at a moment is the published one
// with the latest effective time not after it. One draft at a time, and a published version's
// items never change (partial unique index and trigger in the migration).
model PriceListVersion {
  tenantId      String    @map("tenant_id") @db.Uuid
  id            String    @id @default(uuid(7)) @db.Uuid
  versionNo     Int       @map("version_no")
  /// DRAFT or PUBLISHED (CHECK in the migration).
  status        String    @default("DRAFT")
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  publishedBy   String?   @map("published_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String    @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  version       Int       @default(1)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  items  PriceListItem[]

  charges Charge[]

  @@unique([tenantId, id])
  @@unique([tenantId, versionNo])
  @@map("price_list_version")
  @@schema("hms")
}

// One price of a price list version (T-BIL-01; C-041). A doctor fee is two rows per practitioner:
// the new-patient fee and the follow-up fee, which also carries the follow-up window in days.
model PriceListItem {
  tenantId           String  @map("tenant_id") @db.Uuid
  id                 String  @id @default(uuid(7)) @db.Uuid
  priceListVersionId String  @map("price_list_version_id") @db.Uuid
  serviceItemId      String  @map("service_item_id") @db.Uuid
  practitionerId     String? @map("practitioner_id") @db.Uuid
  unitPrice          Decimal @map("unit_price") @db.Decimal(18, 2)
  followUpDays       Int?    @map("follow_up_days")

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  priceListVersion PriceListVersion @relation(fields: [tenantId, priceListVersionId], references: [tenantId, id])
  serviceItem      ServiceItem      @relation(fields: [tenantId, serviceItemId], references: [tenantId, id])
  practitioner     Practitioner?    @relation(fields: [tenantId, practitionerId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, priceListVersionId])
  @@map("price_list_item")
  @@schema("hms")
}

// An invoice of a visit (T-BIL-02; FR-BIL-001, FR-BIL-008; C-008; E section 5.4): the doctor's fee
// on a DOCTOR_FEE invoice, services on the visit's SERVICE invoice. total and paid are projections
// kept in the transaction that changes the lines; status is derived from them. visit_id gets its
// foreign key with the visit table (T-VIS-01). CHECKs and partial unique indexes are in SQL.
model Invoice {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @id @default(uuid(7)) @db.Uuid
  number    String
  /// DOCTOR_FEE or SERVICE (CHECK in the migration).
  type      String
  patientId String   @map("patient_id") @db.Uuid
  visitId   String   @map("visit_id") @db.Uuid
  currency  String   @default("BDT") @db.Char(3)
  /// ISSUED, PARTIALLY_PAID, PAID or CANCELLED (CHECK in the migration).
  status    String   @default("ISSUED")
  total     Decimal  @default(0) @db.Decimal(18, 2)
  paid      Decimal  @default(0) @db.Decimal(18, 2)
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz
  issuedBy  String   @map("issued_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  version   Int      @default(1)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  patient     Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id])
  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  visit Visit @relation(fields: [tenantId, visitId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, patientId])
  @@map("invoice")
  @@schema("hms")
}

// One priced posting from another module (T-BIL-02; FR-BIL-006, FR-BIL-033; FPR-09; ADR-009):
// unique by its source reference, append-only, and keeping the price list version that priced it.
model Charge {
  tenantId           String   @map("tenant_id") @db.Uuid
  id                 String   @id @default(uuid(7)) @db.Uuid
  patientId          String   @map("patient_id") @db.Uuid
  visitId            String   @map("visit_id") @db.Uuid
  serviceItemId      String   @map("service_item_id") @db.Uuid
  practitionerId     String?  @map("practitioner_id") @db.Uuid
  sourceModule       String   @map("source_module")
  sourceType         String   @map("source_type")
  sourceId           String   @map("source_id")
  sourceEvent        String   @map("source_event")
  quantity           Decimal  @db.Decimal(14, 3)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(18, 2)
  amount             Decimal  @db.Decimal(18, 2)
  priceListVersionId String   @map("price_list_version_id") @db.Uuid
  serviceTime        DateTime @map("service_time") @db.Timestamptz
  postedAt           DateTime @default(now()) @map("posted_at") @db.Timestamptz
  postedBy           String   @map("posted_by") @db.Uuid

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  patient          Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id])
  serviceItem      ServiceItem      @relation(fields: [tenantId, serviceItemId], references: [tenantId, id])
  practitioner     Practitioner?    @relation(fields: [tenantId, practitionerId], references: [tenantId, id])
  priceListVersion PriceListVersion @relation(fields: [tenantId, priceListVersionId], references: [tenantId, id])
  line             InvoiceLine?

  visit Visit @relation(fields: [tenantId, visitId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, sourceModule, sourceType, sourceId, sourceEvent], map: "charge_source_reference_key")
  @@map("charge")
  @@schema("hms")
}

// One line of an invoice, exactly one per charge (T-BIL-02; E section 3.2). Amount allocation and
// payment eligibility come with payments (T-BIL-04).
model InvoiceLine {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @id @default(uuid(7)) @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  chargeId        String   @map("charge_id") @db.Uuid
  lineNo          Int      @map("line_no")
  /// MEDICINE or NON_MEDICINE (SRC-B03; CHECK in the migration).
  category        String
  netAmount       Decimal  @map("net_amount") @db.Decimal(18, 2)
  /// ACTIVE, CANCELLED or REVERSED (CHECK in the migration).
  status          String   @default("ACTIVE")
  /// T-BIL-04: paid so far; never more than netAmount (CHECK in the migration).
  allocatedAmount Decimal  @default(0) @map("allocated_amount") @db.Decimal(18, 2)
  /// ELIGIBLE when fully paid (C-040 FULL_PAYMENT), else NOT_ELIGIBLE.
  eligibility     String   @default("NOT_ELIGIBLE")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  version         Int      @default(1)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  invoice     Invoice             @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  charge      Charge              @relation(fields: [tenantId, chargeId], references: [tenantId, id])
  allocations PaymentAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, chargeId])
  @@unique([tenantId, invoiceId, lineNo])
  @@map("invoice_line")
  @@schema("hms")
}

// A patient's attendance (T-VIS-01; FR-VIS-001..004; C-006, C-007; E section 5.3; mod-clinical).
// Check-in of an appointment creates exactly one OPD_CONSULTATION visit with the session's next
// serial number (C-035). Kind, status and serial-number CHECKs are in the migration.
model Visit {
  tenantId                String   @map("tenant_id") @db.Uuid
  id                      String   @id @default(uuid(7)) @db.Uuid
  facilityId              String   @map("facility_id") @db.Uuid
  departmentId            String?  @map("department_id") @db.Uuid
  patientId               String   @map("patient_id") @db.Uuid
  /// OPD_CONSULTATION, DIAGNOSTIC or EMERGENCY (CHECK in the migration).
  kind                    String
  /// OPEN, COMPLETED or CANCELLED (CHECK in the migration).
  status                  String   @default("OPEN")
  attendingPractitionerId String?  @map("attending_practitioner_id") @db.Uuid
  appointmentId           String?  @map("appointment_id") @db.Uuid
  scheduleSessionId       String?  @map("schedule_session_id") @db.Uuid
  queueNumber             Int?     @map("queue_number")
  arrivedAt               DateTime @default(now()) @map("arrived_at") @db.Timestamptz
  createdBy               String   @map("created_by") @db.Uuid
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz
  version                 Int      @default(1)

  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  facility              Facility         @relation(fields: [tenantId, facilityId], references: [tenantId, id])
  department            Department?      @relation(fields: [tenantId, departmentId], references: [tenantId, id])
  patient               Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id])
  attendingPractitioner Practitioner?    @relation(fields: [tenantId, attendingPractitionerId], references: [tenantId, id])
  appointment           Appointment?     @relation(fields: [tenantId, appointmentId], references: [tenantId, id])
  scheduleSession       ScheduleSession? @relation(fields: [tenantId, scheduleSessionId], references: [tenantId, id])
  invoices              Invoice[]
  charges               Charge[]

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId])
  @@index([tenantId, patientId, arrivedAt(sort: Desc)], map: "visit_patient_idx")
  @@map("visit")
  @@schema("hms")
}

// A cashier's working session (T-BIL-03; FR-BIL-026; UC-BIL-04; mod-billing). OPEN until the
// cashier closes it with the counted amounts, then CLOSED_PENDING_REVIEW until a finance user
// other than the cashier reviews it. State, time and segregation CHECKs are in the migration.
model CashierSession {
  tenantId     String    @map("tenant_id") @db.Uuid
  id           String    @id @default(uuid(7)) @db.Uuid
  facilityId   String    @map("facility_id") @db.Uuid
  cashierId    String    @map("cashier_id") @db.Uuid
  /// OPEN, CLOSED_PENDING_REVIEW or REVIEWED (CHECK in the migration).
  status       String    @default("OPEN")
  openingFloat Decimal   @default(0) @map("opening_float") @db.Decimal(18, 2)
  openedAt     DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNote   String?   @map("review_note")
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  version      Int       @default(1)

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  facility Facility              @relation(fields: [tenantId, facilityId], references: [tenantId, id])
  counts   CashierSessionCount[]
  payments Payment[]

  @@unique([tenantId, id])
  @@index([tenantId, cashierId, openedAt(sort: Desc)], map: "cashier_session_cashier_idx")
  @@map("cashier_session")
  @@schema("hms")
}

// The amounts of one payment method at closing: expected from the payments, counted by the
// cashier, and the variance (counted - expected, CHECK in the migration). Written once.
model CashierSessionCount {
  tenantId  String  @map("tenant_id") @db.Uuid
  id        String  @id @default(uuid(7)) @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  /// CASH, CARD, MOBILE or BANK_TRANSFER (CHECK in the migration).
  method    String
  expected  Decimal @db.Decimal(18, 2)
  counted   Decimal @db.Decimal(18, 2)
  variance  Decimal @db.Decimal(18, 2)

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  session CashierSession @relation(fields: [tenantId, sessionId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, method], map: "cashier_session_count_session_method_key")
  @@map("cashier_session_count")
  @@schema("hms")
}

// Money a cashier received in an open session (T-BIL-04; FR-BIL-004, FR-BIL-011; C-010, C-039).
// Append-only; method, amount and status CHECKs are in the migration.
model Payment {
  tenantId          String   @map("tenant_id") @db.Uuid
  id                String   @id @default(uuid(7)) @db.Uuid
  receiptNumber     String   @map("receipt_number")
  patientId         String   @map("patient_id") @db.Uuid
  cashierSessionId  String   @map("cashier_session_id") @db.Uuid
  /// CASH, CARD, MOBILE or BANK_TRANSFER (CHECK in the migration).
  method            String
  providerLabel     String?  @map("provider_label")
  externalReference String?  @map("external_reference")
  amount            Decimal  @db.Decimal(18, 2)
  status            String   @default("RECORDED")
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz
  receivedBy        String   @map("received_by") @db.Uuid

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  patient        Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id])
  cashierSession CashierSession      @relation(fields: [tenantId, cashierSessionId], references: [tenantId, id])
  allocations    PaymentAllocation[]
  prints         ReceiptPrint[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId, receivedAt], map: "payment_day_idx")
  @@index([tenantId, cashierSessionId], map: "payment_session_idx")
  @@index([tenantId, patientId], map: "payment_patient_idx")
  @@map("payment")
  @@schema("hms")
}

// The part of a payment that pays one invoice line (T-BIL-04; P-020, ADR-016). Append-only.
model PaymentAllocation {
  tenantId            String  @map("tenant_id") @db.Uuid
  id                  String  @id @default(uuid(7)) @db.Uuid
  paymentId           String  @map("payment_id") @db.Uuid
  invoiceId           String  @map("invoice_id") @db.Uuid
  invoiceLineId       String  @map("invoice_line_id") @db.Uuid
  amount              Decimal @db.Decimal(18, 2)
  /// The invoice's balance right after the payment, for receipts and reprints (FR-BIL-027).
  invoiceBalanceAfter Decimal @map("invoice_balance_after") @db.Decimal(18, 2)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  payment     Payment     @relation(fields: [tenantId, paymentId], references: [tenantId, id])
  invoice     Invoice     @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  invoiceLine InvoiceLine @relation(fields: [tenantId, invoiceLineId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId, invoiceLineId], map: "payment_allocation_payment_line_key")
  @@index([tenantId, invoiceLineId], map: "payment_allocation_line_idx")
  @@index([tenantId, invoiceId], map: "payment_allocation_invoice_idx")
  @@map("payment_allocation")
  @@schema("hms")
}

// One print of a receipt (T-BIL-04; FR-BIL-027); copy 2 and later are reprints. Append-only.
model ReceiptPrint {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @id @default(uuid(7)) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  copyNo    Int      @map("copy_no")
  /// en, bn-BD or bilingual (CHECK in the migration).
  language  String
  printedAt DateTime @default(now()) @map("printed_at") @db.Timestamptz
  printedBy String   @map("printed_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [tenantId, paymentId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId, copyNo], map: "receipt_print_payment_copy_key")
  @@map("receipt_print")
  @@schema("hms")
}
